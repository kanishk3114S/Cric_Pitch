# ==============================================================================
# CricScript AI — Backend Environment Configuration (.env.example)
# Copy to backend/.env and populate with genuine API credentials.
# NEVER commit production keys to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# --- LLM: Google Gemini API (Required) ---
# Obtain key at: https://aistudio.google.com/apikey
# Must be enabled for Gemini 3.8 / 3.1 Flash & Pro models
GEMINI_API_KEY=your_gemini_api_key_here

# Optional secondary fallback key for research agent
# GEMINI_API_KEY_RESEARCH=your_secondary_gemini_key_here

# --- Web Search: Tavily API (Required for live multi-hop research) ---
# Obtain key at: https://tavily.com (1,000 free searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# --- Vector Database: Pinecone (Optional for Cadence-RAG) ---
# If omitted, system automatically falls back to local style exemplar repository
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=cricscript-rag

# --- Security & CORS Configuration ---
# Origin of the deployed frontend on Vercel (e.g. https://cricpitch.vercel.app)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed origins (e.g. custom domain, preview)
# ALLOWED_ORIGINS=https://cricpitch.com,https://www.cricpitch.com
